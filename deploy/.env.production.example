# Copy to deploy/.env on the server, fill it in, then: chmod 600 deploy/.env
# Never commit the filled file. Keep a copy of MFA_SECRET_KEY in a password manager.

# The public address, without https:// (Caddy uses it for the certificate).
APP_DOMAIN=app.example.co.il
# The same address with https://. Every link sent to clients starts with it.
PUBLIC_WEB_URL=https://app.example.co.il

# RDS PostgreSQL in il-central-1. The password must not contain @ : / or %.
DATABASE_URL=postgresql+asyncpg://docket:CHANGE_ME@docketflow-db.xxxxxxxx.il-central-1.rds.amazonaws.com:5432/docketai

# S3 in il-central-1. Leave the keys blank: the server's IAM role is used.
S3_BUCKET=docketflow-files-CHANGE_ME
S3_REGION=il-central-1
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SES in il-central-1 through its API (Tel Aviv has no SES SMTP endpoint). The domain must be verified in SES.
EMAIL_FROM=office@example.co.il
SES_REGION=il-central-1
SES_CONFIGURATION_SET=

# Seals two-step login secrets and reminder links. Generate once:
#   docker run --rm python:3.11-slim python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Changing or losing it breaks every two-step login and every reminder link.
MFA_SECRET_KEY=

# AI reading. Document text goes to the provider (outside Israel). Each office can turn it off in settings.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

LOG_LEVEL=INFO
SESSION_TTL_HOURS=12
