{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CaseFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::BUCKET_NAME/*"
    },
    {
      "Sid": "ListCaseFiles",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::BUCKET_NAME"
    },
    {
      "Sid": "SendEmail",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "il-central-1" },
        "StringLike": { "ses:FromAddress": "*@YOUR_DOMAIN" }
      }
    }
  ]
}
