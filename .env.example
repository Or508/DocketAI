# Copy to .env at the repo root, or to apps/api/.env.
# SQLite is the local default so the API can boot without Docker.
# For Postgres: postgresql+asyncpg://docket:docket@localhost:5432/docketai

DATABASE_URL=sqlite+aiosqlite:///./data/docketai.db
REDIS_URL=redis://localhost:6379/0
# Host development keeps this false: the API does the work in-process, and that
# work is lost if the API restarts. The full stack (`docker compose --profile app`)
# sets it true and runs a worker. With it true and no worker health key, the API
# still falls back to in-process work instead of leaving the case processing.
QUEUE_ENABLED=false
QDRANT_URL=http://localhost:6333
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
CONFIDENCE_THRESHOLD=0.75
AUTO_CREATE_SCHEMA=true
LOG_LEVEL=INFO
SESSION_TTL_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
CHAT_STREAM_IDLE_TIMEOUT_SECONDS=20
PUBLIC_WEB_URL=http://localhost:3000
SIGNING_LINK_TTL_HOURS=72
SIGNING_LINK_DOWNLOAD_HOURS=168
SIGNING_LINK_MAX_CHAT_TURNS=40

# local writes under STORAGE_DIR. s3 uses the bucket below.
# Leave the access key and secret blank to use the default AWS credential chain.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=

# The compose RustFS service from the host. These match its dev-only defaults.
# The application default stays "local" so pytest needs no bucket.
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=docketai
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=docket
# S3_SECRET_ACCESS_KEY=docket-local-dev
# S3_FORCE_PATH_STYLE=true

# Optional absolute paths. Empty uses the built-in defaults.
STORAGE_DIR=
TEMPLATE_DIR=
HEBREW_FONT_PATH=

# File intake. The checker runs in a separate process. Leave CLAMAV_HOST empty
# to skip malware scanning. The compose "scan" profile listens on 127.0.0.1:3310.
PREFLIGHT_TIMEOUT_SECONDS=20
PREFLIGHT_MEMORY_MB=768
PREFLIGHT_MAX_PAGES=300
PREFLIGHT_MAX_PAGE_INCHES=200
PREFLIGHT_MAX_DECOMPRESSED_MB=512
PREFLIGHT_MAX_IMAGE_PIXELS=50000000
PREFLIGHT_REJECT_PDF_JAVASCRIPT=true
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
