# Copy to .env at the repo root, or to apps/api/.env.
# SQLite is the local default so the API can boot without Docker.
# For Postgres: postgresql+asyncpg://docket:docket@localhost:5432/docketai

DATABASE_URL=sqlite+aiosqlite:///./data/docketai.db
REDIS_URL=redis://localhost:6379/0
# Host development keeps this false: the API does the work in-process, and that
# work is lost if the API restarts. The full stack (`docker compose --profile app`)
# sets it true and runs a worker. With it true and no worker health key, the API
# still falls back to in-process work instead of leaving the case processing.
QUEUE_ENABLED=false
# "off" turns label memory off where a host cannot hold an empty value (Render).
QDRANT_URL=http://localhost:6333
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
CONFIDENCE_THRESHOLD=0.75
# production refuses development defaults (SQLite, local files, outbox email, http, no MFA_SECRET_KEY).
# See deploy/.env.production.example and docs/deploy/aws-tel-aviv.md.
ENVIRONMENT=development
AUTO_CREATE_SCHEMA=true
LOG_LEVEL=INFO
SESSION_TTL_HOURS=12
# Wrong logins lock one address out of one account; the account itself locks only after
# LOGIN_ACCOUNT_MAX_FAILURES from anywhere.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_ACCOUNT_MAX_FAILURES=25
# Per-address request limits (in API memory). Login: attempts per window. Public: portal, intake, verify.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=30
LOGIN_RATE_WINDOW_SECONDS=900
PUBLIC_RATE_LIMIT=120
PUBLIC_RATE_WINDOW_SECONDS=60
CHAT_STREAM_IDLE_TIMEOUT_SECONDS=20
# Messages to clients. outbox = write each email as an .eml file in OUTBOX_DIR (development),
# smtp = send through the server below, ses = Amazon SES API (SES_REGION, the default AWS credentials),
# disabled = no email (WhatsApp links still work).
EMAIL_BACKEND=outbox
SES_REGION=
SES_CONFIGURATION_SET=
OUTBOX_DIR=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
# Reminder days after the first message; reminders go out only in these Israel hours, never on Saturday.
REMINDER_DAYS=2,5
REMINDER_START_HOUR=9
REMINDER_END_HOUR=20
MAX_MESSAGES_PER_CASE_PER_DAY=10
# The links in emails and WhatsApp messages start with this address, so set it to the public site.
PUBLIC_WEB_URL=http://localhost:3000
# Web only: the header that carries the visitor's address. Blank = rightmost X-Forwarded-For (Caddy, nginx).
# On Render (behind Cloudflare): cf-connecting-ip.
CLIENT_IP_HEADER=
SIGNING_LINK_TTL_HOURS=72
SIGNING_LINK_DOWNLOAD_HOURS=168
SIGNING_LINK_MAX_CHAT_TURNS=40

# local writes under STORAGE_DIR. s3 uses the bucket below.
# Leave the access key and secret blank to use the default AWS credential chain.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=

# The compose RustFS service from the host. These match its dev-only defaults.
# The application default stays "local" so pytest needs no bucket.
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=docketai
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=docket
# S3_SECRET_ACCESS_KEY=docket-local-dev
# S3_FORCE_PATH_STYLE=true

# Optional absolute paths. Empty uses the built-in defaults.
STORAGE_DIR=
TEMPLATE_DIR=
HEBREW_FONT_PATH=

# File intake. The checker runs in a separate process. Leave CLAMAV_HOST empty
# to skip malware scanning. The compose "scan" profile listens on 127.0.0.1:3310.
PREFLIGHT_TIMEOUT_SECONDS=20
PREFLIGHT_MEMORY_MB=768
PREFLIGHT_MAX_PAGES=300
PREFLIGHT_MAX_PAGE_INCHES=200
PREFLIGHT_MAX_DECOMPRESSED_MB=512
PREFLIGHT_MAX_IMAGE_PIXELS=50000000
PREFLIGHT_REJECT_PDF_JAVASCRIPT=true
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
